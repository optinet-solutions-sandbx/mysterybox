# Copy to .env.local. Nothing here is required while NEXT_PUBLIC_BACKEND=mock (the default).

# mock     – everything runs in the browser; the box system runs the backend developer's logic (src/box-api/mock.ts)
# api      – the box system calls the backend developer's API at NEXT_PUBLIC_BOX_API_URL (src/box-api/http.ts)
# supabase – the earlier placeholder adapter in src/backend/supabase-api.ts (superseded, not wired to the UI)
NEXT_PUBLIC_BACKEND=mock

# Base URL of the backend developer's box API (without /v1), used when NEXT_PUBLIC_BACKEND=api.
NEXT_PUBLIC_BOX_API_URL=

# "off" hides the box page's Analysis section (it shows the per-open maths, i.e. the operator's margin).
NEXT_PUBLIC_SHOW_ANALYSIS=on

# Supabase project (Settings → API). The anon/publishable key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (payment webhooks, cron). Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# "on" adds 240 generated sample players to the back office (demos). Off: only real test accounts.
NEXT_PUBLIC_DEMO_PLAYERS=off

# Product photos borrowed from themistybox.com for the mock-up; "off" switches to line drawings.
NEXT_PUBLIC_REFERENCE_IMAGES=on
