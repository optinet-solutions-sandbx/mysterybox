# Copy to .env.local. Nothing here is required while NEXT_PUBLIC_BACKEND=mock (the default).

# Box system (opens, payments, credit):
# mock – runs the backend developer's logic in the browser (src/box-api/mock.ts)
# api  – calls the backend developer's API at NEXT_PUBLIC_BOX_API_URL (src/box-api/http.ts)
NEXT_PUBLIC_BACKEND=mock

# Base URL of the backend developer's box API (without /v1), used when NEXT_PUBLIC_BACKEND=api.
NEXT_PUBLIC_BOX_API_URL=

# "off" hides the box page's Analysis section (it shows the per-open maths, i.e. the operator's margin).
NEXT_PUBLIC_SHOW_ANALYSIS=on

# Accounts: "supabase" moves login and identity (sign-up code, sign-in, roles, locks, tags, comments,
# staff, audit) to Supabase. Needs the URL and anon key below. Anything else: accounts in this browser.
NEXT_PUBLIC_ACCOUNTS=
# "supabase" serves items, boxes and odds from the database and lets staff add and edit them in the
# back office (docs/11-white-label.md). Empty: the built-in catalogue, read-only.
NEXT_PUBLIC_CATALOG=

# Brand pack to show: a folder in public/brands/ (default grailnoir). New one: npm run brand:new -- <id> "Name"
NEXT_PUBLIC_BRAND=

# Supabase project (Settings → API). The anon/publishable key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (adding staff, payment webhooks). Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# "on" adds 240 generated sample players to the back office (demos). Off: only real test accounts.
NEXT_PUBLIC_DEMO_PLAYERS=off

# Product photos borrowed from themistybox.com for the mock-up; "off" switches to line drawings.
NEXT_PUBLIC_REFERENCE_IMAGES=on

# Daily task reports to the team's PMS (CLAUDE.md "Daily PMS report", scripts/pms.mjs). Personal API token
# from the PMS (Settings → API tokens). Never commit real values.
PMS_BASE_URL=https://pms-nu-eight.vercel.app
PMS_PROJECT_ID=
PMS_USER_ID=
PMS_API_TOKEN=
