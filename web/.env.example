# Copy to .env.local. Nothing here is required while NEXT_PUBLIC_BACKEND=mock (the default).

# mock     – everything runs in the browser (store/auth.ts, store/session.ts, data/demo-players.ts)
# supabase – the placeholder adapter in src/backend/supabase-api.ts (not wired to the UI yet)
NEXT_PUBLIC_BACKEND=mock

# Supabase project (Settings → API). The anon/publishable key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (payment webhooks, cron). Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Product photos borrowed from themistybox.com for the mock-up; "off" switches to line drawings.
NEXT_PUBLIC_REFERENCE_IMAGES=on
